# Never commit a real API key.
ASTROVISOR_API_KEY=pk-...
ASTROVISOR_URL=https://astrovisor.io
ASTROVISOR_MCP_URL=https://mcp.astrovisor.io/
ASTROVISOR_DEFAULT_PROFILE=me
ASTROVISOR_PROFILE_UPDATE_POLICY=ask

# Optional path overrides:
# ASTROVISOR_SKILL_HOME=/absolute/path/to/private/astrovisor-config
# ASTROVISOR_PROFILE_DIR=/absolute/path/to/private/profiles
