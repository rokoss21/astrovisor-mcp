{
  "name": "astrovisor-mcp",
  "version": "4.2.7",
  "description": "AstroVisor MCP for stdio and Streamable HTTP with live OpenAPI discovery, compact tools and token-efficient results.",
  "main": "build/index.js",
  "bin": {
    "astrovisor-mcp": "build/index.js"
  },
  "type": "module",
  "scripts": {
    "build": "tsc && node -e \"require('fs').chmodSync('build/index.js', '755')\"",
    "start": "node build/index.js",
    "dev": "npm run build && npm start",
    "start:http": "node build/http-server.js",
    "start:jsonrpc": "node build/mcp-http-server.js",
    "start:public": "node build/mcp-public-server.js",
    "test": "node test-production.cjs",
    "test:unit": "npm run build && node test-interop.mjs",
    "test:e2e:stdio": "node test-stdio-client.mjs",
    "test:e2e:remote": "node test-remote-client.mjs",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "mcp",
    "astrovisor",
    "astrology",
    "openapi",
    "claude",
    "ai",
    "streamable-http"
  ],
  "author": "Emil Rokossovskiy <emil@astrovisor.io>",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/rokoss21/astrovisor-mcp.git"
  },
  "homepage": "https://astrovisor.io",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.29.0",
    "axios": "^1.18.1",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "^5.2.1"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "^20.0.0",
    "typescript": "^5.0.0"
  },
  "overrides": {
    "@hono/node-server": "^2.0.5"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "files": [
    "build/",
    "README.md",
    "LICENSE"
  ]
}
